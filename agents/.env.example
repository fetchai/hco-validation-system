# ──────────────────────────────────────────────
# Core Configuration
# ──────────────────────────────────────────────
AGENTVERSE_URL=https://agentverse.ai
CERT_OUTPUT_DIR=generated_certificates

# ──────────────────────────────────────────────
# API Keys (required)
# ──────────────────────────────────────────────
OPENAI_API_KEY=

# ──────────────────────────────────────────────
# OpenAI Model Settings (optional)
# ──────────────────────────────────────────────
OPENAI_VISION_MODEL=gpt-4o
MAX_TOKENS=1024

# ──────────────────────────────────────────────
# Database (optional — falls back to local JSON files)
# ──────────────────────────────────────────────
# DATABASE_URL=postgresql://user:pass@localhost:5432/hco

# ──────────────────────────────────────────────
# Microsoft Authentication (for personal accounts)
# ──────────────────────────────────────────────
MS_TENANT_ID=consumers
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REFRESH_TOKEN=

# ──────────────────────────────────────────────
# Microsoft Excel & OneDrive Configuration
# ──────────────────────────────────────────────
EXCEL_SHARE_URL=
ONEDRIVE_FOLDER_SHARE_URL=
EXCEL_TABLE_NAME=Certificates
EXCEL_FILE_NAME=Book.xlsx
EXCEL_ITEM_ID=
# ──────────────────────────────────────────────
# Feature Flags (optional)
# ──────────────────────────────────────────────
# Allow certificate generation without Microsoft login (not recommended for production)
HCO_PUBLIC_GENERATION=false
# Check Excel before local DB/fallback during verification
HCO_VERIFY_EXCEL_FIRST=false
